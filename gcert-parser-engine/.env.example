# Copy this file to .env and fill in real values
# Never commit .env to version control!

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "gemini" | "ollama"
# Use "gemini" in cloud (Ollama is not available on cloud servers)
LLM_PROVIDER=gemini

# ── Ollama (local only, leave blank in cloud) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Firebase ──────────────────────────────────────────────────────────────────
# OPTION A: Local file path (for local development)
GOOGLE_APPLICATION_CREDENTIALS=../serviceAccountKey.json

# OPTION B: Base64-encoded JSON (for cloud deployment — paste in platform dashboard)
# Generate with: base64 -i serviceAccountKey.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 string here>

FIREBASE_PROJECT_ID=quizapp-1627022258976
FIRESTORE_DATABASE_ID=

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://e03f2f07-f5cd-412f-9ab3-fbe9030cb3e6.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=gyandeep_topics

# ── Redis (optional, for Celery) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── HuggingFace cache (set automatically in Dockerfile) ──────────────────────
# HF_HOME=/app/hf_cache
